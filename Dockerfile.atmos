FROM nvidia/cuda:12.9.0-devel-ubuntu24.04

# Set non-interactive mode to avoid apt-get prompts
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cgdb \
    wget \
    gfortran \
    git \
    scons \
    python3 \
    libfftw3-dev \
    libfftw3-mpi-dev \
    libblas-dev \
    liblapack-dev \
    libgsl-dev \
    libpmix-dev \
    vim \
    nodejs \
    npm \
    clangd \
    clang-format \
    clang-tidy \
    autoconf \
    automake \
    libtool \
    doxygen \
    graphviz \
    && rm -rf /var/lib/apt/lists/*

# Build cmake
RUN wget https://github.com/Kitware/CMake/releases/download/v4.1.2/cmake-4.1.2-linux-x86_64.tar.gz \
    && tar -zxvf cmake-4.1.2-linux-x86_64.tar.gz -C /opt/ \
    && ln -s /opt/cmake-4.1.2-linux-x86_64/bin/* /usr/local/bin/ \
    && rm cmake-4.1.2-linux-x86_64.tar.gz

# Build OpenMPI with PMIx and CUDA support
# (Must be built before PFFT!)
RUN wget https://download.open-mpi.org/release/open-mpi/v5.0/openmpi-5.0.8.tar.gz \
    && tar -xzf openmpi-5.0.8.tar.gz \
    && cd openmpi-5.0.8 \
    && ./configure \
        --prefix=/usr/local \
        --with-pmix \
        --with-cuda=/usr/local/cuda \
        --with-cuda-libdir=/usr/local/cuda/lib64/stubs \
    && make -j$(nproc) all \
    && make install \
    && ldconfig \
    && cd .. \
    && rm -rf openmpi-5.0.8 openmpi-5.0.8.tar.gz
#TODO - Also build with UCX?

# Build PFFT float and double versions
RUN cd /opt \
    && git clone https://github.com/mpip/pfft.git \
    && cd pfft \
    && ./bootstrap.sh \
    && CC=mpicc FC=mpif90 ./configure --prefix=/usr/local \
    && make -j$(nproc) \
    && make install \
    && make clean \
    && CC=mpicc FC=mpif90 ./configure --prefix=/usr/local --enable-float \
    && make -j$(nproc) \
    && make install \
    && cd /opt \
    && rm -rf pfft

WORKDIR /opt

# Create a build directory inside the container
WORKDIR /opt/build
